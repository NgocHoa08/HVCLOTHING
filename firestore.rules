rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Danh mục sản phẩm: Khách xem tự do, Quản trị viên toàn quyền thêm / sửa / xóa
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Đơn hàng:
    // - Cho phép khách gửi đơn hàng (create)
    // - Cho phép người dùng đọc đơn hàng của chính mình (theo userId) hoặc tra cứu mã đơn
    // - Quản trị viên có toàn quyền đọc, duyệt trạng thái và xóa đơn
    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Đăng ký nhận tin tức / khuyến mãi
    match /newsletterSubscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Quản lý thông tin tài khoản người dùng
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Danh sách quyền Admin
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}