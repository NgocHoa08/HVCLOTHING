rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'slug', 'name', 'category', 'categoryLabel', 'subcategory', 'gender',
          'price', 'description', 'details', 'material', 'care', 'sizes', 'colors',
          'rating', 'reviews', 'inStock', 'images'
        ])
        && data.keys().hasOnly([
          'id', 'slug', 'name', 'category', 'categoryLabel', 'subcategory', 'gender',
          'price', 'salePrice', 'description', 'details', 'material', 'care', 'sizes',
          'colors', 'rating', 'reviews', 'badge', 'inStock', 'images', 'isNew',
          'isFeatured', 'isBestSeller'
        ])
        && data.id == productId
        && data.slug is string
        && data.name is string
        && data.category in ['women', 'men', 'accessories', 'collections']
        && data.gender in ['women', 'men', 'unisex']
        && data.price is number
        && data.price >= 0
        && data.description is string
        && data.details is list
        && data.material is string
        && data.care is list
        && data.sizes is list
        && data.colors is list
        && data.images is list
        && data.images.size() > 0
        && data.images.size() <= 12
        && data.rating is number
        && data.rating >= 0
        && data.rating <= 5
        && data.reviews is int
        && data.reviews >= 0
        && data.inStock is bool
        && (!('salePrice' in data)
          || (data.salePrice is number && data.salePrice >= 0 && data.salePrice <= data.price));
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data, productId);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
          'orderCode', 'customer', 'shipping', 'items', 'subtotal', 'discount',
          'couponCode', 'shippingFee', 'total', 'paymentMethod', 'status', 'userId', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderCode', 'customer', 'shipping', 'items', 'subtotal', 'discount',
          'couponCode', 'shippingFee', 'total', 'paymentMethod', 'status', 'userId', 'createdAt'
        ])
        && request.resource.data.orderCode is string
        && request.resource.data.customer is map
        && request.resource.data.customer.keys().hasAll(['email', 'fullName', 'phone'])
        && request.resource.data.customer.keys().hasOnly(['email', 'fullName', 'phone'])
        && request.resource.data.customer.email is string
        && request.resource.data.customer.fullName is string
        && request.resource.data.customer.phone is string
        && request.resource.data.shipping is map
        && request.resource.data.shipping.keys().hasAll(['address', 'city', 'district', 'ward'])
        && request.resource.data.shipping.keys().hasOnly(['address', 'city', 'district', 'ward'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount is number
        && request.resource.data.discount >= 0
        && request.resource.data.shippingFee is number
        && request.resource.data.shippingFee >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.paymentMethod in ['cod', 'bank', 'card']
        && request.resource.data.status == 'new'
        && (request.resource.data.userId == null
          || (signedIn() && request.resource.data.userId == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'confirmed', 'packing', 'shipped', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'status', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'status', 'source', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.status == 'subscribed'
        && request.resource.data.source == 'website-newsletter'
        && request.resource.data.createdAt == request.time;
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['subscribed', 'unsubscribed'];
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}